{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".+\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "primepestcontrol.ae"
        }
      ],
      "destination": "https://www.primepestcontrol.ae/$1",
      "permanent": true
    },
    {
      "source": "/pest-control-near-me",
      "destination": "/",
      "permanent": true
    },
