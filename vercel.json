{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "primepestcontrol.ae" }],
      "destination": "https://www.primepestcontrol.ae/$1",
      "permanent": true
    }
  ]
}
